  {\setmainfont{Times New Roman}}
  {\setmainfont{TeX Gyre Termes}}
\setsansfont{Arial}
\setmonofont{Courier New}[Scale=MatchLowercase]

\RequirePackage[a4paper,left=3.5cm,right=2cm,top=3cm,bottom=3cm,headheight=15pt,footskip=1.27cm]{geometry}
