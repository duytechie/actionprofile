\newcommand{\ctucoverframe}{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[line width=1.4pt]
      ([xshift=0.9cm,yshift=-0.9cm]current page.north west)
      rectangle
      ([xshift=-0.9cm,yshift=0.9cm]current page.south east);
    \draw[line width=0.45pt]
      ([xshift=1.05cm,yshift=-1.05cm]current page.north west)
      rectangle
      ([xshift=-1.05cm,yshift=1.05cm]current page.south east);
  \end{tikzpicture}%
}

