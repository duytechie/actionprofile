\hypersetup{
  unicode=true,
  colorlinks=false,
  pdfborder={0 0 0},
  bookmarksnumbered=true,
  bookmarksopen=true,
  bookmarksopenlevel=1,
  pdfpagemode=UseOutlines
}

% Page typography measured from the source document.
\AtBeginDocument{\fontsize{13pt}{19.5pt}\selectfont}
% The 19.5 pt baseline above already provides 1.5 times the 13 pt font size.
\setstretch{1}
\setlength{\parindent}{0.5cm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\raggedbottom

% The source uses centered page numbers and no running header.
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% Chapter headings use Roman numerals; subordinate and float numbering stays Arabic.
\renewcommand{\thechapter}{\Roman{chapter}}
\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\renewcommand{\thefigure}{\arabic{chapter}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{chapter}.\arabic{table}}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

\titleformat{\chapter}[block]
  {\centering\bfseries\fontsize{16pt}{19pt}\selectfont}
  {CHƯƠNG \thechapter:}{0.35em}{\MakeUppercase}
% Unstarred spacing preserves the first-line indent after each heading.
\titlespacing{\chapter}{0pt}{0pt}{18pt}

\titleformat{\section}
  {\bfseries\fontsize{13pt}{16pt}\selectfont}
  {\thesection.}{0.45em}{}
\titlespacing{\section}{0pt}{2pt}{0pt}

\titleformat{\subsection}
  {\bfseries\fontsize{13pt}{16pt}\selectfont}
  {\thesubsection.}{0.45em}{}
\titlespacing{\subsection}{0pt}{2pt}{0pt}

\titleformat{\subsubsection}
  {\itshape\fontsize{13pt}{16pt}\selectfont}
  {\thesubsubsection.}{0.45em}{}
\titlespacing{\subsubsection}{0pt}{0pt}{0pt}

% Unnumbered front-matter headings.
\newcommand{\ctuheading}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%
  \begin{center}
    \bfseries\fontsize{16pt}{19pt}\selectfont #1
  \end{center}
  \vspace{12pt}
  % Restore normal paragraph indentation after the centered heading.
  \@afterindenttrue\@afterheading
}

% Introduction headings are numbered 1, 2, ... independently of chapters.
\newcounter{introsection}
\newcounter{introsubsection}[introsection]
\newcommand{\introsection}[1]{%
  \refstepcounter{introsection}%
  \par\vspace{2pt}\noindent
  {\bfseries\fontsize{13pt}{16pt}\selectfont \theintrosection. #1}\par
  \addcontentsline{toc}{section}{\protect\numberline{\theintrosection.}#1}%
}
\newcommand{\introsubsection}[1]{%
  \refstepcounter{introsubsection}%
  \par\noindent
  {\bfseries\fontsize{13pt}{16pt}\selectfont \theintrosection.\theintrosubsection. #1}\par
  \addcontentsline{toc}{subsection}{\protect\numberline{\theintrosection.\theintrosubsection.}#1}%
}

